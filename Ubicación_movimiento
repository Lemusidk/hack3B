  // ── STORE MARKERS ──
  let selectedStore = null;
  let routeLine = null;
  let selectedMarker = null;

  const storeIcon = L.divIcon({
    className: '',
    html: `<div style="
      width:12px;height:12px;
      background:#7b61ff;
      border-radius:50%;
      border:2px solid rgba(123,97,255,0.4);
      box-shadow:0 0 8px rgba(123,97,255,0.5);
    "></div>`,
    iconSize: [12, 12],
    iconAnchor: [6, 6],
  });

  const storeIconSelected = L.divIcon({
    className: '',
    html: `<div style="
      width:16px;height:16px;
      background:#7b61ff;
      border-radius:50%;
      border:3px solid #fff;
      box-shadow:0 0 0 3px rgba(123,97,255,0.5), 0 0 16px rgba(123,97,255,0.7);
    "></div>`,
    iconSize: [16, 16],
    iconAnchor: [8, 8],
  });

  stores.forEach(store => {
    const marker = L.marker([store.lat, store.lon], { icon: storeIcon }).addTo(map);

    marker.on('click', () => {
      // Reset previous selected marker
      if (selectedMarker && selectedMarker !== marker) {
        selectedMarker.setIcon(storeIcon);
      }
      marker.setIcon(storeIconSelected);
      selectedMarker = marker;
      selectedStore = store;

      // Update sidebar
      document.getElementById('dest-name').textContent = store.name;
      document.getElementById('dest-address').textContent = `${store.address} · ${store.borough}`;
      document.getElementById('dest-panel').classList.add('visible');
      document.getElementById('route-info').classList.remove('visible');
      document.getElementById('btn-confirm').disabled = false;
      document.getElementById('btn-confirm').textContent = '➤ Confirmar ruta';

      // Popup with confirm button
      marker.bindPopup(`
        <div style="min-width:180px">
          <b style="color:#00f5c4;font-size:0.8rem">${store.name}</b><br/>
          <span style="color:#6b6b88;font-size:0.7rem">${store.address}</span><br/>
          <span style="color:#6b6b88;font-size:0.7rem">${store.borough} · ${store.region_name}</span>
          <button class="popup-confirm-btn" onclick="confirmRoute()">➤ Confirmar ruta</button>
        </div>
      `).openPopup();
    });
  });

  // ── IMAGE UPLOAD ──
  let userImageDataUrl = null;

  function handleImageUpload(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      userImageDataUrl = ev.target.result;
      const preview = document.getElementById('upload-preview');
      preview.src = userImageDataUrl;
      preview.classList.add('visible');
      document.getElementById('upload-zone').classList.add('has-image');
      document.getElementById('upload-label').textContent = file.name.length > 20
        ? file.name.slice(0, 18) + '…'
        : file.name;
      document.getElementById('upload-icon') && (document.querySelector('.upload-icon').style.display = 'none');
      // Enable start button if route exists
      if (routeCoords && routeCoords.length > 0) {
        document.getElementById('btn-start-anim').disabled = false;
      }
    };
    reader.readAsDataURL(file);
  }

  // ── ANIMATION STATE ──
  let routeCoords = [];
  let animMarker = null;
  let animInterval = null;
  let animIndex = 0;

  function buildAnimIcon(dataUrl) {
    return L.divIcon({
      className: '',
      html: `<img src="${dataUrl}" style="
        width:40px; height:40px;
        border-radius:50%;
        object-fit:cover;
        border:2px solid #00f5c4;
        box-shadow:0 0 10px rgba(0,245,196,0.6);
        transform:translate(-50%,-50%);
        display:block;
      "/>`,
      iconSize: [0, 0],
      iconAnchor: [0, 0],
    });
  }

  function startAnimation() {
    if (!userImageDataUrl) return;
    if (!routeCoords || routeCoords.length < 2) return;

    stopAnimation(); // clear any previous

    const speed = parseInt(document.getElementById('speed-slider').value);
    // step size: higher speed = skip more points per tick
    const step = Math.max(1, Math.round(speed * 1.5));
    const intervalMs = Math.max(30, 120 - speed * 10);

    animIndex = 0;
    animMarker = L.marker(routeCoords[0], { icon: buildAnimIcon(userImageDataUrl), zIndexOffset: 1000 }).addTo(map);

    document.getElementById('btn-stop-anim').style.display = 'block';
    document.getElementById('btn-start-anim').textContent = '⟳ Animando...';
    document.getElementById('btn-start-anim').disabled = true;

    animInterval = setInterval(() => {
      animIndex += step;
      if (animIndex >= routeCoords.length) {
        // Loop: restart from beginning
        animIndex = 0;
      }
      animMarker.setLatLng(routeCoords[animIndex]);

      // Rotate icon toward next point
      if (animIndex + step < routeCoords.length) {
        const curr = routeCoords[animIndex];
        const next = routeCoords[Math.min(animIndex + step, routeCoords.length - 1)];
        const angle = Math.atan2(next[1] - curr[1], next[0] - curr[0]) * 180 / Math.PI;
        const img = animMarker.getElement()?.querySelector('img');
        if (img) img.style.transform = `translate(-50%,-50%) rotate(${angle}deg)`;
      }
    }, intervalMs);
  }

  function stopAnimation() {
    if (animInterval) { clearInterval(animInterval); animInterval = null; }
    if (animMarker) { map.removeLayer(animMarker); animMarker = null; }
    document.getElementById('btn-stop-anim').style.display = 'none';
    document.getElementById('btn-start-anim').textContent = '▶ Iniciar animación';
    document.getElementById('btn-start-anim').disabled = !userImageDataUrl;
  }

  // ── ROUTING via OSRM (free, no API key) ──
  function confirmRoute() {
    if (!selectedStore) return;

    const btn = document.getElementById('btn-confirm');
    btn.disabled = true;
    btn.textContent = '⟳ Calculando...';

    const destLat = selectedStore.lat;
    const destLon = selectedStore.lon;

    // Get user position
    if (!userMarker) {
      showError('Primero obtén tu ubicación con el botón Localizar.');
      btn.disabled = false;
      btn.textContent = '➤ Confirmar ruta';
      return;
    }

    const userPos = userMarker.getLatLng();
    const url = `https://router.project-osrm.org/route/v1/driving/${userPos.lng},${userPos.lat};${destLon},${destLat}?overview=full&geometries=geojson`;

    fetch(url)
      .then(r => r.json())
      .then(data => {
        if (data.code !== 'Ok') throw new Error('Sin ruta disponible');

        const route = data.routes[0];
        const coords = route.geometry.coordinates.map(([lng, lat]) => [lat, lng]);
        const distKm = (route.distance / 1000).toFixed(1);
        const mins = Math.round(route.duration / 60);
        const timeStr = mins >= 60
          ? `${Math.floor(mins/60)}h ${mins % 60}min`
          : `${mins} min`;

        // Remove old route
        if (routeLine) map.removeLayer(routeLine);

        // Draw animated route
        routeLine = L.polyline(coords, {
          color: '#7b61ff',
          weight: 4,
          opacity: 0.85,
          dashArray: '8, 4',
          lineJoin: 'round',
        }).addTo(map);

        // Save route coords for animation
        routeCoords = coords;
        stopAnimation(); // reset previous anim

        // Show animation panel
        document.getElementById('anim-panel').classList.add('visible');
        if (userImageDataUrl) {
          document.getElementById('btn-start-anim').disabled = false;
        }

        // Fit map to route
        map.fitBounds(routeLine.getBounds(), { padding: [40, 40] });

        // Update route info
        document.getElementById('route-dist').textContent = `${distKm} km`;
        document.getElementById('route-time').textContent = timeStr;
        document.getElementById('route-info').classList.add('visible');
        document.getElementById('dest-panel').classList.remove('visible');

        btn.disabled = false;
        btn.textContent = '➤ Confirmar ruta';
      })
      .catch(err => {
        showError('No se pudo calcular la ruta. Verifica tu conexión.');
        btn.disabled = false;
        btn.textContent = '➤ Confirmar ruta';
      });
  }

  function cancelRoute() {
    if (routeLine) { map.removeLayer(routeLine); routeLine = null; }
    if (selectedMarker) { selectedMarker.setIcon(storeIcon); selectedMarker = null; }
    selectedStore = null;
    routeCoords = [];
    stopAnimation();
    document.getElementById('dest-panel').classList.remove('visible');
    document.getElementById('route-info').classList.remove('visible');
    document.getElementById('anim-panel').classList.remove('visible');
    map.closePopup();
  }

  // Hide loading overlay once map is ready
  map.whenReady(() => {
    setTimeout(() => document.getElementById('loading-overlay').classList.add('hidden'), 600);
  });

  // ── CUSTOM MARKER ──
  const markerIcon = L.divIcon({
    className: 'custom-marker',
    html: '<div class="marker-inner"></div>',
    iconSize: [40, 40],
    iconAnchor: [20, 20],
  });

  let userMarker = null;
  let accuracyCircle = null;

  function setLayer(name, btn) {
    if (name === currentLayer) return;
    map.removeLayer(layers[currentLayer]);
    layers[name].addTo(map);
    currentLayer = name;
    document.querySelectorAll('.layer-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  // ── GEOLOCATION ──
  function locateMe() {
    const btn = document.getElementById('btn-locate');
    const badge = document.getElementById('status-badge');
    const errorBox = document.getElementById('error-box');

    errorBox.style.display = 'none';
    btn.disabled = true;
    btn.textContent = '⟳ Localizando...';
    badge.className = 'status-badge';
    badge.textContent = '● Buscando señal';

    if (!navigator.geolocation) {
      showError('Tu navegador no soporta geolocalización.');
      btn.disabled = false;
      return;
    }

    navigator.geolocation.getCurrentPosition(onSuccess, onError, {
      enableHighAccuracy: true,
      timeout: 12000,
      maximumAge: 0,
    });
  }

  function onSuccess(pos) {
    const { latitude: lat, longitude: lng, altitude, speed, accuracy } = pos.coords;
    const btn = document.getElementById('btn-locate');
    const badge = document.getElementById('status-badge');

    // Update badge
    badge.className = 'status-badge active';
    badge.textContent = '● Señal activa';

    // Update coords
    document.getElementById('lat-val').textContent = lat.toFixed(6) + '°';
    document.getElementById('lng-val').textContent = lng.toFixed(6) + '°';
    document.getElementById('alt-val').textContent = altitude != null ? altitude.toFixed(1) + ' m' : 'N/D';
    document.getElementById('speed-val').textContent = speed != null ? (speed * 3.6).toFixed(1) + ' km/h' : 'N/D';

    // Remove skeleton
    document.querySelectorAll('.coord-val').forEach(el => el.classList.remove('skeleton'));
    document.getElementById('coord-card').classList.add('loaded');

    // Precision bar (accuracy: lower = better; cap at 500m)
    const pct = Math.max(0, Math.min(100, 100 - (accuracy / 5)));
    document.getElementById('precision-bar').style.width = pct + '%';
    document.getElementById('precision-label').textContent = `±${accuracy.toFixed(0)} m de precisión`;

    // Remove old marker & circle
    if (userMarker) map.removeLayer(userMarker);
    if (accuracyCircle) map.removeLayer(accuracyCircle);

    // Add accuracy circle
    accuracyCircle = L.circle([lat, lng], {
      radius: accuracy,
      color: '#7b61ff',
      fillColor: '#7b61ff',
      fillOpacity: 0.08,
      weight: 1,
    }).addTo(map);

    // Add marker
    userMarker = L.marker([lat, lng], { icon: markerIcon })
      .addTo(map)
      .bindPopup(`
        <b style="color:#00f5c4">📍 Tu ubicación</b><br/>
        ${lat.toFixed(5)}, ${lng.toFixed(5)}<br/>
        <span style="color:#6b6b88">Precisión: ±${accuracy.toFixed(0)}m</span>
      `)
      .openPopup();

    map.flyTo([lat, lng], 16, { duration: 1.5, easeLinearity: 0.3 });

    btn.disabled = false;
    btn.textContent = '↺ Actualizar';
  }

  function onError(err) {
    const messages = {
      1: 'Permiso de ubicación denegado. Por favor, permite el acceso en tu navegador.',
      2: 'No se pudo obtener tu posición. Verifica tu señal GPS.',
      3: 'Tiempo de espera agotado. Intenta de nuevo.',
    };
    showError(messages[err.code] || 'Error desconocido al obtener ubicación.');

    const btn = document.getElementById('btn-locate');
    const badge = document.getElementById('status-badge');
    badge.className = 'status-badge error';
    badge.textContent = '● Error de señal';
    btn.disabled = false;
    btn.textContent = '◎ Reintentar';
  }

  function showError(msg) {
    const box = document.getElementById('error-box');
    box.style.display = 'block';
    box.textContent = '⚠ ' + msg;
  }

  // Auto-locate on load
  window.addEventListener('load', () => {
    setTimeout(locateMe, 800);
  });
</script>
